generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum Gender {
  MALE
  FEMALE
}

enum EnrollmentAction {
  JOIN
  LEAVE
}

enum TeacherAssignmentAction {
  ASSIGN
  REMOVED
}

enum SessionStatus {
  DRAFT
  FINISHED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// Placeholder status shared by Assignment/Test until their real shapes are decided.
enum RecordStatus {
  DRAFT
  FINISHED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role
  gender    Gender?
  isActive  Boolean  @default(true)
  avatarUrl String?
  createdAt DateTime @default(now())

  teacher Teacher?
  student Student?
}

model Teacher {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  subjects     TeacherSubject[]
  groupHistory GroupTeacher[]
  reports      Report[]
  invoiceLines InvoiceLine[]
}

model Student {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])
  // Manually assigned by an admin (Settings → User), used as the last
  // component of an InvoiceLine's invoiceNo — see that model's comment.
  studentNumber Int? @unique

  enrollmentHistory GroupEnrollment[]
  sessionAttendance SessionAttendance[]
  reports           Report[]
  invoices          Invoice[]
}

enum ReportHeaderPattern {
  NONE
  LINES
  DOTS
  BLOCKS
  SWIRL
}

enum ReportFont {
  HELVETICA
  POPPINS
  PT_SERIF
}

// Global report PDF template config — one row, applies to every report
// regardless of subject. Deliberately separate from ReportTheme (which is
// per-subject, color only): title/footer/font/cover are institution-wide,
// not something that should vary by subject.
model ReportSettings {
  id               String              @id @default(cuid())
  title            String              @default("Laporan Belajar")
  organizationName String              @default("Ihsanify")
  logoUrl          String?
  websiteUrl       String?
  footerPhone      String?
  footerEmail      String?
  footerInstagram  String?
  font             ReportFont          @default(HELVETICA)
  headerPattern    ReportHeaderPattern @default(NONE)
  coverImageUrl    String?
}

model Subject {
  id            String       @id @default(cuid())
  name          String       @unique
  // e.g. "Bahasa Arab" -> "AR" — used as the first component of an
  // InvoiceLine's invoiceNo, see that model's comment.
  subjectCode   String?      @unique
  reportThemeId String?
  reportTheme   ReportTheme? @relation(fields: [reportThemeId], references: [id])

  groups   Group[]
  teachers TeacherSubject[]
}

// A named color preset for Report PDF covers/banners/footers. One primary
// color, always paired with white text — presets are curated to guarantee
// contrast rather than allowing an arbitrary/unsafe color combination.
model ReportTheme {
  id           String    @id @default(cuid())
  name         String    @unique
  primaryColor String
  subjects     Subject[]
}

model TeacherSubject {
  teacherId String
  subjectId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])
  subject   Subject @relation(fields: [subjectId], references: [id])

  @@id([teacherId, subjectId])
}

model Group {
  id        String    @id @default(cuid())
  name      String
  subjectId String
  isActive  Boolean   @default(true)
  startDate DateTime  @default(now())
  endDate   DateTime?
  subject   Subject   @relation(fields: [subjectId], references: [id])

  enrollmentHistory GroupEnrollment[]
  teacherHistory    GroupTeacher[]
  sessions          Session[]
  reports           Report[]
  assignments       Assignment[]
  invoiceLines      InvoiceLine[]
  plannedSessions   PlannedSession[]
}

// A group's recurring weekly meeting slots (e.g. "every Tuesday at 20:00 WIB").
// Distinct from Session, which logs a meeting that actually happened — this is
// the schedule, not the log. Times are plain "HH:mm" strings with no timezone
// field, since the app is single-locale (WIB) throughout.
model PlannedSession {
  id        String    @id @default(cuid())
  groupId   String
  dayOfWeek DayOfWeek
  time      String
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model GroupEnrollment {
  id        String           @id @default(cuid())
  groupId   String
  studentId String
  action    EnrollmentAction
  date      DateTime         @default(now())
  group     Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student   Student          @relation(fields: [studentId], references: [id])
}

model GroupTeacher {
  id        String                  @id @default(cuid())
  groupId   String
  teacherId String
  action    TeacherAssignmentAction
  date      DateTime                @default(now())
  group     Group                   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teacher   Teacher                 @relation(fields: [teacherId], references: [id])
}

model Session {
  id                 String        @id @default(cuid())
  groupId            String
  date               DateTime
  durationMinutes    Int
  status             SessionStatus @default(DRAFT)
  attendanceRecorded Boolean       @default(false)
  createdAt          DateTime      @default(now())
  group              Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)

  attendance   SessionAttendance[]
  invoiceLines InvoiceLine[]       @relation("InvoiceLineSessions")
}

model SessionAttendance {
  id        String  @id @default(cuid())
  sessionId String
  studentId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id])

  @@unique([sessionId, studentId])
}

// Monthly progress report, written by a group's teacher for one student.
// submittedAt/readAt double as the visibility + status gate:
//   null / null      -> draft, only visible to admin/teacher
//   set  / null      -> "Submitted by {teacher}", visible to the assigned student
//   set  / set       -> "Read by {student}"
// Teacher/student names are looked up at render time via teacherId/studentId,
// never denormalized onto this row.
// score stays the single source of truth (kept for future progress-over-time
// graphing); the qualitative grade label (Mumtaz/Jayyid Jiddan/Jayyid/Maqbul/
// Dhaif) is a pure function of score, derived at read time in reports.ts —
// never stored, so it can't drift out of sync with the number it's based on.
model Report {
  id          String    @id @default(cuid())
  groupId     String
  studentId   String
  teacherId   String
  month       Int
  year        Int
  progress    String
  advice      String
  score       Int
  submittedAt DateTime?
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  group       Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student     Student   @relation(fields: [studentId], references: [id])
  teacher     Teacher   @relation(fields: [teacherId], references: [id])
}

// Placeholder shape — fields to be refined once the real Assignment design is discussed.
model Assignment {
  id          String       @id @default(cuid())
  groupId     String
  title       String
  description String
  status      RecordStatus @default(DRAFT)
  createdAt   DateTime     @default(now())
  group       Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

// Monthly invoice for one student, covering every group they're billed for
// that month — one InvoiceLine per group, since a student can be enrolled in
// more than one group at once and each group needs its own manually-entered
// price. Price stays a flat manual figure rather than a proportional
// (attended/expected × price-per-month) formula — that was an open edge
// case, resolved by making it manual instead.
model Invoice {
  id        String        @id @default(cuid())
  studentId String
  month     Int
  year      Int
  // Manually ticked by an admin once the PDF has actually been sent to the
  // student — not inferred from a download or any other action, since
  // "downloaded by admin" and "handed to the student" aren't the same event.
  sent      Boolean       @default(false)
  createdAt DateTime      @default(now())
  student   Student       @relation(fields: [studentId], references: [id])
  lines     InvoiceLine[]
}

// One group's line item within an Invoice. `sessions` snapshots exactly
// which of that group's sessions counted as "attended" for this student at
// generation time (mirrors the event-sourced-history philosophy used for
// enrollment/teacher-assignment elsewhere): if attendance for that month is
// corrected later, past invoices keep showing what they showed when they
// were generated. `invoiceNo` is computed once at creation time from the
// group's subject code + the invoice's year/month + the student's student
// number (e.g. "AR-2026-08-001") and stored rather than recomputed — same
// snapshot reasoning as `sessions`: if the subject code or student number
// changes later, past invoices keep the number they were issued with.
model InvoiceLine {
  id        String    @id @default(cuid())
  invoiceId String
  groupId   String
  teacherId String
  invoiceNo String
  price     Int
  invoice   Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  group     Group     @relation(fields: [groupId], references: [id])
  teacher   Teacher   @relation(fields: [teacherId], references: [id])
  sessions  Session[] @relation("InvoiceLineSessions")
}

// Global invoice PDF settings — one row, applies to every invoice. Kept
// separate from ReportSettings (which is report-domain only) since bank
// details are specific to billing, not report cards.
model InvoiceSettings {
  id          String  @id @default(cuid())
  bankName    String?
  bankAccount String?
}
