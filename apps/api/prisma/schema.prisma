generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum Gender {
  MALE
  FEMALE
}

enum EnrollmentAction {
  JOIN
  LEAVE
}

enum TeacherAssignmentAction {
  ASSIGN
  REMOVED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// Placeholder status shared by Assignment/Test until their real shapes are decided.
enum RecordStatus {
  DRAFT
  FINISHED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role
  gender    Gender?
  isActive  Boolean  @default(true)
  avatarUrl String?
  // Self-editable profile fields (Profile page) — distinct from the
  // admin-managed fields above (name/email/gender/isActive via Settings → User).
  bio       String?
  address   String?
  phone     String?
  createdAt DateTime @default(now())

  teacher       Teacher?
  student       Student?
  notifications Notification[]
}

enum NotificationType {
  REPORT
  ASSIGNMENT
  GROUP_ASSIGNMENT
}

// One row per recipient per event — a group of 5 students getting the same
// assignment creates 5 rows, not 1 row fanned out at read time. Simpler to
// query ("my unread count") at the cost of some duplication, which is fine
// at this app's scale.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  // Frontend route to deep-link to, e.g. "/reports" or "/groups/abc/assignments".
  // Null means informational only, nothing to click through to.
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())
}

enum TeacherTitle {
  S_PD
  S_T
  LC
}

model Teacher {
  id     String        @id @default(cuid())
  userId String        @unique
  user   User          @relation(fields: [userId], references: [id])
  // Academic title, optional — set by the teacher on their own Profile page.
  title  TeacherTitle?

  subjects        TeacherSubject[]
  groupHistory    GroupTeacher[]
  reports         Report[]
  invoiceLines    InvoiceLine[]
  rates           TeacherRate[]
  payslips        Payslip[]
  teachingHistory TeachingHistory[]
}

// A teacher's prior work history before joining — freeform organization name
// since it covers outside schools/institutions not modeled elsewhere here.
// Self-managed by the teacher from their own Profile page.
model TeachingHistory {
  id           String  @id @default(cuid())
  teacherId    String
  teacher      Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  startYear    Int
  endYear      Int
  organization String
}

// Fixed list for now, per the Profile page's school selection field — add
// values here (+ migration) as more partner schools come on.
enum School {
  MEDINA_INTERNATIONAL_SCHOOL
  AL_WILDAN_INTERNATIONAL_ISLAMIC_SCHOOL
}

model Student {
  id            String  @id @default(cuid())
  userId        String  @unique
  // Set by the student on their own Profile page.
  school        School?
  user          User    @relation(fields: [userId], references: [id])
  // Manually assigned by an admin (Settings → User), used as the last
  // component of an InvoiceLine's invoiceNo — see that model's comment.
  studentNumber Int?    @unique

  enrollmentHistory GroupEnrollment[]
  sessionAttendance SessionAttendance[]
  reports           Report[]
  invoices          Invoice[]
  payslipLines      PayslipLine[]
}

enum ReportHeaderPattern {
  NONE
  LINES
  DOTS
  BLOCKS
  SWIRL
}

enum ReportFont {
  HELVETICA
  POPPINS
  PT_SERIF
}

// Global report PDF template config — one row, applies to every report
// regardless of subject. Deliberately separate from ReportTheme (which is
// per-subject, color only): title/footer/font/cover are institution-wide,
// not something that should vary by subject.
model ReportSettings {
  id               String              @id @default(cuid())
  title            String              @default("Laporan Belajar")
  organizationName String              @default("Ihsanify")
  logoUrl          String?
  websiteUrl       String?
  footerPhone      String?
  footerEmail      String?
  footerInstagram  String?
  font             ReportFont          @default(HELVETICA)
  headerPattern    ReportHeaderPattern @default(NONE)
  coverImageUrl    String?
}

model Subject {
  id            String       @id @default(cuid())
  name          String       @unique
  // e.g. "Bahasa Arab" -> "AR" — used as the first component of an
  // InvoiceLine's invoiceNo, see that model's comment.
  subjectCode   String?      @unique
  reportThemeId String?
  reportTheme   ReportTheme? @relation(fields: [reportThemeId], references: [id])

  groups   Group[]
  teachers TeacherSubject[]
}

// A named color preset for Report PDF covers/banners/footers. One primary
// color, always paired with white text — presets are curated to guarantee
// contrast rather than allowing an arbitrary/unsafe color combination.
model ReportTheme {
  id           String    @id @default(cuid())
  name         String    @unique
  primaryColor String
  subjects     Subject[]
}

model TeacherSubject {
  teacherId String
  subjectId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])
  subject   Subject @relation(fields: [subjectId], references: [id])

  @@id([teacherId, subjectId])
}

enum GroupType {
  GROUP
  PRIVATE
  SEMI_PRIVATE
}

model Group {
  id        String    @id @default(cuid())
  name      String
  subjectId String
  isActive  Boolean   @default(true)
  startDate DateTime  @default(now())
  endDate   DateTime?
  // Configured in Settings → Group. cardColor is a hex string shown as the
  // group's card background on the Groups page; falls back to the
  // isActive-based default color when unset.
  cardColor String?
  groupType GroupType @default(GROUP)
  subject   Subject   @relation(fields: [subjectId], references: [id])

  enrollmentHistory GroupEnrollment[]
  teacherHistory    GroupTeacher[]
  sessions          Session[]
  reports           Report[]
  assignments       Assignment[]
  invoiceLines      InvoiceLine[]
  plannedSessions   PlannedSession[]
  payslipLines      PayslipLine[]
}

// A group's recurring weekly meeting slots (e.g. "every Tuesday at 20:00 WIB").
// Distinct from Session, which logs a meeting that actually happened — this is
// the schedule, not the log. Times are plain "HH:mm" strings with no timezone
// field, since the app is single-locale (WIB) throughout.
model PlannedSession {
  id        String    @id @default(cuid())
  groupId   String
  dayOfWeek DayOfWeek
  time      String
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model GroupEnrollment {
  id        String           @id @default(cuid())
  groupId   String
  studentId String
  action    EnrollmentAction
  date      DateTime         @default(now())
  group     Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student   Student          @relation(fields: [studentId], references: [id])
}

model GroupTeacher {
  id        String                  @id @default(cuid())
  groupId   String
  teacherId String
  action    TeacherAssignmentAction
  date      DateTime                @default(now())
  group     Group                   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teacher   Teacher                 @relation(fields: [teacherId], references: [id])
}

model Session {
  id                 String   @id @default(cuid())
  groupId            String
  date               DateTime
  durationMinutes    Int
  attendanceRecorded Boolean  @default(false)
  createdAt          DateTime @default(now())
  group              Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  attendance   SessionAttendance[]
  invoiceLines InvoiceLine[]       @relation("InvoiceLineSessions")
}

model SessionAttendance {
  id        String  @id @default(cuid())
  sessionId String
  studentId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id])

  @@unique([sessionId, studentId])
}

// Monthly progress report, written by a group's teacher for one student.
// submittedAt/readAt double as the visibility + status gate:
//   null / null      -> draft, only visible to admin/teacher
//   set  / null      -> "Submitted by {teacher}", visible to the assigned student
//   set  / set       -> "Read by {student}"
// Teacher/student names are looked up at render time via teacherId/studentId,
// never denormalized onto this row.
// score stays the single source of truth (kept for future progress-over-time
// graphing); the qualitative grade label (Mumtaz/Jayyid Jiddan/Jayyid/Maqbul/
// Dhaif) is a pure function of score, derived at read time in reports.ts —
// never stored, so it can't drift out of sync with the number it's based on.
model Report {
  id          String    @id @default(cuid())
  groupId     String
  studentId   String
  teacherId   String
  month       Int
  year        Int
  progress    String
  advice      String
  score       Int
  submittedAt DateTime?
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  group       Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student     Student   @relation(fields: [studentId], references: [id])
  teacher     Teacher   @relation(fields: [teacherId], references: [id])
}

// Placeholder shape — fields to be refined once the real Assignment design is discussed.
model Assignment {
  id          String       @id @default(cuid())
  groupId     String
  title       String
  description String
  status      RecordStatus @default(DRAFT)
  createdAt   DateTime     @default(now())
  group       Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

// Monthly invoice for one student, covering every group they're billed for
// that month — one InvoiceLine per group, since a student can be enrolled in
// more than one group at once and each group needs its own manually-entered
// price. Price stays a flat manual figure rather than a proportional
// (attended/expected × price-per-month) formula — that was an open edge
// case, resolved by making it manual instead.
model Invoice {
  id        String        @id @default(cuid())
  studentId String
  month     Int
  year      Int
  // Manually ticked by an admin once the PDF has actually been sent to the
  // student — not inferred from a download or any other action, since
  // "downloaded by admin" and "handed to the student" aren't the same event.
  sent      Boolean       @default(false)
  createdAt DateTime      @default(now())
  student   Student       @relation(fields: [studentId], references: [id])
  lines     InvoiceLine[]
}

// One group's line item within an Invoice. `sessions` snapshots exactly
// which of that group's sessions counted as "attended" for this student at
// generation time (mirrors the event-sourced-history philosophy used for
// enrollment/teacher-assignment elsewhere): if attendance for that month is
// corrected later, past invoices keep showing what they showed when they
// were generated. `invoiceNo` is computed once at creation time from the
// group's subject code + the invoice's year/month + the student's student
// number (e.g. "AR-2026-08-001") and stored rather than recomputed — same
// snapshot reasoning as `sessions`: if the subject code or student number
// changes later, past invoices keep the number they were issued with.
model InvoiceLine {
  id        String    @id @default(cuid())
  invoiceId String
  groupId   String
  teacherId String
  invoiceNo String
  price     Int
  invoice   Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  group     Group     @relation(fields: [groupId], references: [id])
  teacher   Teacher   @relation(fields: [teacherId], references: [id])
  sessions  Session[] @relation("InvoiceLineSessions")
}

// Global invoice PDF settings — one row, applies to every invoice. Kept
// separate from ReportSettings (which is report-domain only) since bank
// details are specific to billing, not report cards.
model InvoiceSettings {
  id           String  @id @default(cuid())
  bankName     String?
  bankAccount  String?
  receiverName String?
}

// A teacher's flat monthly rate per group type they may teach (Settings →
// User). Drives Payslip cost math: a teacher earns this rate ONCE PER
// STUDENT enrolled in a group of that type, not once per group — e.g. a
// Semi-Private group with 2 students contributes 2x the Semi-Private rate to
// that teacher's cost, regardless of each student's attendance that month.
model TeacherRate {
  id          String    @id @default(cuid())
  teacherId   String
  groupType   GroupType
  monthlyRate Int
  teacher     Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, groupType])
}

// One calendar month's payroll — the real parent entity a month/year period
// represents, not just a query filter. totalRevenue/totalCost/totalProfit/
// totalGroup are deliberately NOT stored here — always computed live from
// this row's Payslips/PayslipLines (GET /payroll), so they can never drift
// out of sync with the records they summarize.
model Payroll {
  id        String    @id @default(cuid())
  month     Int
  year      Int
  createdAt DateTime  @default(now())
  payslips  Payslip[]

  @@unique([month, year])
}

// One payslip per teacher per Payroll period — the parent record for that
// teacher's PayslipLine rows. Uniqueness on [payrollId, teacherId] is a
// deliberate guard against double-counting the same teacher's cost/profit
// twice in a period's aggregate totals.
model Payslip {
  id        String        @id @default(cuid())
  payrollId String
  teacherId String
  createdAt DateTime      @default(now())
  payroll   Payroll       @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  teacher   Teacher       @relation(fields: [teacherId], references: [id])
  lines     PayslipLine[]

  @@unique([payrollId, teacherId])
}

// One (group, student) line within a Payslip. Every value here is a frozen
// snapshot taken at creation time — sessionsAttended/sessionsTotal and
// teacherRateSnapshot/groupTypeSnapshot are computed server-side from the
// group's actual roster/sessions "as of" that month, so the payslip doesn't
// silently change later if a rate is edited or a student's enrollment is
// corrected retroactively. `price` is the admin's manually entered per-
// student amount (the "profit" contribution — negotiated with parents,
// deliberately not derived from attendance).
model PayslipLine {
  id                  String    @id @default(cuid())
  payslipId           String
  groupId             String
  studentId           String
  sessionsAttended    Int
  sessionsTotal       Int
  price               Int
  groupTypeSnapshot   GroupType
  teacherRateSnapshot Int
  payslip             Payslip   @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  group               Group     @relation(fields: [groupId], references: [id])
  student             Student   @relation(fields: [studentId], references: [id])
}

// Landing page testimonials, admin-managed via Settings → Landing. Public
// read (no auth) since this is exactly the content it's meant to display;
// only create/update/delete are admin-gated.
model Testimonial {
  id        String   @id @default(cuid())
  name      String
  message   String
  // When the testimony was actually given — editable by the admin, since
  // testimonials are often entered well after the fact (e.g. copied from an
  // old WhatsApp conversation). Deliberately separate from createdAt, which
  // is pure system record-keeping (when the row was added) and must never
  // silently stand in for this.
  givenAt   DateTime @default(now())
  createdAt DateTime @default(now())
}

// One row, global — a manually-set number added to the live-computed
// session-hour stat on the landing page (GET /public/stats), representing
// real teaching hours that happened before this LMS existed (since 2021)
// and were never tracked as individual Session rows here. Deliberately not
// backdated as fake Session/attendance records — this app's Session rows
// feed real Payroll/Invoice/Report calculations, and pre-2026 attendance
// wasn't tracked at that granularity anyway.
model LandingStats {
  id                     String @id @default(cuid())
  historicalSessionHours Int    @default(0)
}
