generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum Gender {
  MALE
  FEMALE
}

enum EnrollmentAction {
  JOIN
  LEAVE
}

enum TeacherAssignmentAction {
  ASSIGN
  REMOVED
}

enum SessionStatus {
  DRAFT
  FINISHED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// Placeholder status shared by Report/Test/Invoice until their real shapes are decided.
enum RecordStatus {
  DRAFT
  FINISHED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role
  gender    Gender?
  isActive  Boolean  @default(true)
  avatarUrl String?
  createdAt DateTime @default(now())

  teacher Teacher?
  student Student?
}

model Teacher {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  subjects     TeacherSubject[]
  groupHistory GroupTeacher[]
  reports      Report[]
}

model Student {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  enrollmentHistory GroupEnrollment[]
  sessionAttendance SessionAttendance[]
  reports           Report[]
}

enum ReportHeaderPattern {
  NONE
  LINES
  DOTS
  BLOCKS
  SWIRL
}

enum ReportFont {
  HELVETICA
  POPPINS
  PT_SERIF
}

// Global report PDF template config — one row, applies to every report
// regardless of subject. Deliberately separate from ReportTheme (which is
// per-subject, color only): title/footer/font/cover are institution-wide,
// not something that should vary by subject.
model ReportSettings {
  id              String              @id @default(cuid())
  title           String              @default("Laporan Belajar")
  organizationName String             @default("Ihsanify")
  footerPhone     String?
  footerEmail     String?
  footerInstagram String?
  font            ReportFont          @default(HELVETICA)
  headerPattern   ReportHeaderPattern @default(NONE)
  coverImageUrl   String?
}

model Subject {
  id            String       @id @default(cuid())
  name          String       @unique
  reportThemeId String?
  reportTheme   ReportTheme? @relation(fields: [reportThemeId], references: [id])

  groups   Group[]
  teachers TeacherSubject[]
}

// A named color preset for Report PDF covers/banners/footers. One primary
// color, always paired with white text — presets are curated to guarantee
// contrast rather than allowing an arbitrary/unsafe color combination.
model ReportTheme {
  id           String    @id @default(cuid())
  name         String    @unique
  primaryColor String
  subjects     Subject[]
}

model TeacherSubject {
  teacherId String
  subjectId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])
  subject   Subject @relation(fields: [subjectId], references: [id])

  @@id([teacherId, subjectId])
}

model Group {
  id        String    @id @default(cuid())
  name      String
  subjectId String
  isActive  Boolean   @default(true)
  startDate DateTime  @default(now())
  endDate   DateTime?
  subject   Subject   @relation(fields: [subjectId], references: [id])

  enrollmentHistory GroupEnrollment[]
  teacherHistory    GroupTeacher[]
  sessions          Session[]
  reports           Report[]
  assignments       Assignment[]
  invoices          Invoice[]
  plannedSessions   PlannedSession[]
}

// A group's recurring weekly meeting slots (e.g. "every Tuesday at 20:00 WIB").
// Distinct from Session, which logs a meeting that actually happened — this is
// the schedule, not the log. Times are plain "HH:mm" strings with no timezone
// field, since the app is single-locale (WIB) throughout.
model PlannedSession {
  id        String    @id @default(cuid())
  groupId   String
  dayOfWeek DayOfWeek
  time      String
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model GroupEnrollment {
  id        String           @id @default(cuid())
  groupId   String
  studentId String
  action    EnrollmentAction
  date      DateTime         @default(now())
  group     Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student   Student          @relation(fields: [studentId], references: [id])
}

model GroupTeacher {
  id        String                  @id @default(cuid())
  groupId   String
  teacherId String
  action    TeacherAssignmentAction
  date      DateTime                @default(now())
  group     Group                   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teacher   Teacher                 @relation(fields: [teacherId], references: [id])
}

model Session {
  id                String        @id @default(cuid())
  groupId           String
  date              DateTime
  durationMinutes   Int
  status            SessionStatus @default(DRAFT)
  attendanceRecorded Boolean      @default(false)
  createdAt         DateTime      @default(now())
  group             Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)

  attendance SessionAttendance[]
}

model SessionAttendance {
  id        String  @id @default(cuid())
  sessionId String
  studentId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id])

  @@unique([sessionId, studentId])
}

// Monthly progress report, written by a group's teacher for one student.
// submittedAt/readAt double as the visibility + status gate:
//   null / null      -> draft, only visible to admin/teacher
//   set  / null      -> "Submitted by {teacher}", visible to the assigned student
//   set  / set       -> "Read by {student}"
// Teacher/student names are looked up at render time via teacherId/studentId,
// never denormalized onto this row.
// score stays the single source of truth (kept for future progress-over-time
// graphing); the qualitative grade label (Mumtaz/Jayyid Jiddan/Jayyid/Maqbul/
// Dhaif) is a pure function of score, derived at read time in reports.ts —
// never stored, so it can't drift out of sync with the number it's based on.
model Report {
  id          String    @id @default(cuid())
  groupId     String
  studentId   String
  teacherId   String
  month       Int
  year        Int
  title       String
  progress    String
  advice      String
  score       Int
  submittedAt DateTime?
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  group       Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student     Student   @relation(fields: [studentId], references: [id])
  teacher     Teacher   @relation(fields: [teacherId], references: [id])
}

// Placeholder shape — fields to be refined once the real Assignment design is discussed.
model Assignment {
  id          String       @id @default(cuid())
  groupId     String
  title       String
  description String
  status      RecordStatus @default(DRAFT)
  createdAt   DateTime     @default(now())
  group       Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

// Placeholder shape — fields to be refined once the real Invoice design is discussed.
model Invoice {
  id          String       @id @default(cuid())
  groupId     String
  title       String
  description String
  status      RecordStatus @default(DRAFT)
  createdAt   DateTime     @default(now())
  group       Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
}


