# Copy this file to .env and fill in real values.
# `pnpm dev` scripts load .env via dotenv — see apps/api/package.json / apps/platform/package.json.

# --- Database ---
# Matches docker-compose.dev.yml's default local Postgres (run `docker compose -f docker-compose.dev.yml up -d`).
DATABASE_URL="postgresql://postgres:postgres@localhost:5440/postgres?schema=public"

# --- Auth ---
# Any long random string — used to sign/verify JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"

# --- Frontend API base URL ---
# Where apps/platform sends its API requests. Must be prefixed with VITE_ so
# Vite exposes it to client code (see apps/platform/src/lib/apiClient.ts).
# Leave unset to fall back to http://localhost:8000 for local dev.
VITE_API_URL=

# --- CORS ---
# Comma-separated list of origins allowed to call this API (apps/api/src/index.ts).
# Must include whatever origin the browser actually sends — localhost when
# developing locally, plus any LAN IP or deployed URL the platform frontend
# is also reachable at (e.g. "http://localhost:3000,http://103.187.146.151:3000").
# Leave unset to fall back to http://localhost:3000 only.
CORS_ORIGINS=

# --- Instagram marquee (optional) ---
# Public direct-download link to a hand-maintained JSON file (e.g. a Dropbox
# share link with `?raw=1` / `?dl=1` so it serves the raw file, not a preview
# page). Shape: [{ "imageUrl": "...", "permalink": "...", "caption": "..." }, ...]
# Leave unset to show placeholder cards in the landing page's Instagram marquee.
INSTAGRAM_POSTS_JSON_URL=

# --- Leftover scaffolding var (not used by any real feature) ---
TEST=
